APP_NAME=QuickSplit Backend
APP_VERSION=0.1.0
DEBUG=false

# PostgreSQL connection string (Supabase: Project Settings -> Database -> Connection string)
DATABASE_URL=postgresql://postgres:password@localhost:5432/quicksplit
DB_ECHO=false

# Security
JWT_SECRET_KEY=supersecret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
BACKEND_CORS_ORIGINS=["*"]
